NODE_ENV=development
PORT=3000
JWT_SECRET=change-me-32-random-bytes
JWT_EXPIRES_IN=30d
OTP_PEPPER=change-me-32-random-bytes
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
DEFAULT_COUNTRY=IN
DATABASE_URL=postgresql://postgres:your-password@localhost:5433/SOSdb
# Download from Firebase Console → Project settings → Service accounts.
# Do not commit this file.
# Development: relative to the backend project folder. Never commit this key.
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# Production (recommended): set this as a hosting-platform secret instead of
# committing or deploying a key file. Omit it locally.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
