NODE_ENV=development
PORT=3000
JWT_SECRET=change-me-32-random-bytes
JWT_EXPIRES_IN=30d
OTP_PEPPER=change-me-32-random-bytes
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
DEFAULT_COUNTRY=IN
DATABASE_URL=postgresql://postgres:your-password@localhost:5433/SOSdb
# Download from Firebase Console → Project settings → Service accounts.
# Do not commit this file.
# Development: relative to the backend project folder. Never commit this key.
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# Production (recommended): set this as a hosting-platform secret instead of
# committing or deploying a key file. Omit it locally.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Shared rate-limit store for OTP request/verify (REST-based Redis — no
# persistent connection, works from serverless). Create a free database at
# upstash.com (or via the Vercel Marketplace Upstash integration) and copy
# both values from its dashboard. Optional locally — omit both and rate
# limiting falls back to in-memory. Required on serverless (Vercel) for
# limits to actually be enforced globally instead of per-instance.
# UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token
